---
import type { ImageResponse } from '../types/api';
import ImageCard from './ImageCard.astro';

export interface Props {
  images: ImageResponse[];
  title?: string;
  showTitle?: boolean;
  showTags?: boolean;
  showMetadata?: boolean;
  columns?: number;
  gap?: number;
  loading?: boolean;
  error?: string | null;
  emptyMessage?: string;
  className?: string;
}

const {
  images = [],
  title = '',
  showTitle = true,
  showTags = false,
  showMetadata = false,
  columns = 0, // 0 = auto-responsive
  gap = 4,
  loading = false,
  error = null,
  emptyMessage = 'No images available',
  className = ''
} = Astro.props;

// Generate CSS custom properties for grid
const gridStyle = {
  '--columns': columns > 0 ? columns.toString() : 'auto-fit',
  '--gap': `${gap * 0.25}rem`, // Convert to rem (gap * 4px / 16px)
} as any;
---

<section class={`image-gallery ${className}`} data-testid="image-gallery">
  {title && (
    <header class="gallery-header">
      <h2 class="gallery-title">{title}</h2>
      {images.length > 0 && (
        <p class="gallery-count">
          {images.length} {images.length === 1 ? 'image' : 'images'}
        </p>
      )}
    </header>
  )}

  {error && (
    <div class="error-state" role="alert" data-testid="error-message">
      <div class="error-icon">⚠️</div>
      <div class="error-content">
        <h3 class="error-title">Something went wrong</h3>
        <p class="error-message">{error}</p>
        <button
          class="error-retry"
          onclick="window.location.reload()"
          type="button"
        >
          Try Again
        </button>
      </div>
    </div>
  )}

  {loading && !error && (
    <div class="loading-state" data-testid="loading-indicator">
      <div class="loading-grid" style={gridStyle}>
        {Array.from({ length: 6 }).map((_, index) => (
          <div key={index} class="loading-skeleton">
            <div class="skeleton-image"></div>
            <div class="skeleton-content">
              <div class="skeleton-title"></div>
              <div class="skeleton-text"></div>
              <div class="skeleton-text short"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {!loading && !error && images.length === 0 && (
    <div class="empty-state" data-testid="empty-state">
      <div class="empty-icon">📸</div>
      <h3 class="empty-title">No Images Found</h3>
      <p class="empty-message">{emptyMessage}</p>
    </div>
  )}

  {!loading && !error && images.length > 0 && (
    <div
      class="gallery-grid"
      style={gridStyle}
      data-testid="images-grid"
    >
      {images.map((image) => (
        <ImageCard
          key={image.id}
          image={image}
          showTitle={showTitle}
          showTags={showTags}
          showMetadata={showMetadata}
          className="gallery-item"
        />
      ))}
    </div>
  )}
</section>

<style>
  .image-gallery {
    @apply space-y-6;
  }

  /* Header Styles */
  .gallery-header {
    @apply flex justify-between items-center flex-wrap gap-4;
  }

  .gallery-title {
    @apply text-2xl md:text-3xl font-bold text-charcoal;
  }

  .gallery-count {
    @apply text-sm text-charcoal/60 bg-sage/10 px-3 py-1 rounded-full;
  }

  /* Gallery Grid */
  .gallery-grid {
    @apply grid gap-[var(--gap)] auto-rows-max;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  /* Responsive grid adjustments */
  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 641px) and (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media (min-width: 1025px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  /* Custom column overrides */
  .gallery-grid[style*="--columns: 1"] {
    grid-template-columns: 1fr !important;
  }

  .gallery-grid[style*="--columns: 2"] {
    grid-template-columns: repeat(2, 1fr) !important;
  }

  .gallery-grid[style*="--columns: 3"] {
    grid-template-columns: repeat(3, 1fr) !important;
  }

  .gallery-grid[style*="--columns: 4"] {
    grid-template-columns: repeat(4, 1fr) !important;
  }

  @media (max-width: 640px) {
    .gallery-grid[style*="--columns: 2"],
    .gallery-grid[style*="--columns: 3"],
    .gallery-grid[style*="--columns: 4"] {
      grid-template-columns: 1fr !important;
    }
  }

  @media (max-width: 1024px) {
    .gallery-grid[style*="--columns: 4"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }

    .gallery-grid[style*="--columns: 3"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  /* Loading State */
  .loading-state {
    @apply space-y-4;
  }

  .loading-grid {
    @apply grid gap-[var(--gap)] auto-rows-max;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .loading-skeleton {
    @apply bg-cream border border-sage/20 rounded-lg overflow-hidden;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .skeleton-image {
    @apply w-full h-48 bg-sage/20;
  }

  .skeleton-content {
    @apply p-4 space-y-3;
  }

  .skeleton-title {
    @apply h-4 bg-sage/20 rounded w-3/4;
  }

  .skeleton-text {
    @apply h-3 bg-sage/10 rounded;
  }

  .skeleton-text.short {
    @apply w-1/2;
  }

  /* Error State */
  .error-state {
    @apply text-center py-12 px-4;
  }

  .error-icon {
    @apply text-4xl mb-4;
  }

  .error-content {
    @apply max-w-md mx-auto space-y-4;
  }

  .error-title {
    @apply text-xl font-semibold text-charcoal;
  }

  .error-message {
    @apply text-charcoal/70;
  }

  .error-retry {
    @apply bg-coral hover:bg-coral/90 text-white px-4 py-2 rounded-lg;
    @apply focus:outline-none focus:ring-2 focus:ring-coral/50 focus:ring-offset-2;
    @apply transition-colors duration-200;
  }

  /* Empty State */
  .empty-state {
    @apply text-center py-16 px-4;
  }

  .empty-icon {
    @apply text-6xl mb-6 opacity-50;
  }

  .empty-title {
    @apply text-xl font-semibold text-charcoal mb-2;
  }

  .empty-message {
    @apply text-charcoal/60;
  }

  /* Gallery Item Enhancements */
  .gallery-item {
    @apply transition-all duration-300 ease-out;
  }

  /* Masonry-style layout for varying image heights */
  @supports (grid-template-rows: masonry) {
    .gallery-grid {
      grid-template-rows: masonry;
    }
  }

  /* Animations */
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gallery-item {
    animation: fadeIn 0.3s ease-out forwards;
  }

  /* Stagger animation for multiple items */
  .gallery-item:nth-child(1) { animation-delay: 0ms; }
  .gallery-item:nth-child(2) { animation-delay: 100ms; }
  .gallery-item:nth-child(3) { animation-delay: 200ms; }
  .gallery-item:nth-child(4) { animation-delay: 300ms; }
  .gallery-item:nth-child(5) { animation-delay: 400ms; }
  .gallery-item:nth-child(6) { animation-delay: 500ms; }

  /* Accessibility improvements */
  @media (prefers-reduced-motion: reduce) {
    .loading-skeleton {
      animation: none;
    }

    .gallery-item {
      animation: none;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .loading-skeleton {
      @apply border-2 border-charcoal;
    }

    .skeleton-image,
    .skeleton-title,
    .skeleton-text {
      @apply bg-charcoal/30;
    }
  }

  /* Print styles */
  @media print {
    .loading-state,
    .error-state {
      @apply hidden;
    }

    .gallery-grid {
      display: block;
    }

    .gallery-item {
      @apply break-inside-avoid mb-4;
    }

    .gallery-header {
      @apply break-after-avoid;
    }
  }

  /* Dark mode support (if implemented) */
  @media (prefers-color-scheme: dark) {
    .gallery-title {
      @apply text-cream;
    }

    .gallery-count {
      @apply text-cream/60 bg-sage/20;
    }

    .error-title,
    .empty-title {
      @apply text-cream;
    }

    .error-message,
    .empty-message {
      @apply text-cream/70;
    }

    .loading-skeleton {
      @apply bg-charcoal/20 border-sage/30;
    }

    .skeleton-image {
      @apply bg-sage/30;
    }

    .skeleton-title,
    .skeleton-text {
      @apply bg-sage/20;
    }
  }
</style>

<script>
  // Progressive enhancement for gallery functionality
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.querySelector('.image-gallery');
    if (!gallery) return;

    // Image loading performance tracking
    let loadedImages = 0;
    let totalImages = 0;
    let loadStartTime = performance.now();

    // Count total images to load
    const images = gallery.querySelectorAll('img');
    totalImages = images.length;

    if (totalImages > 0) {
      // Track individual image loads
      images.forEach((img) => {
        img.addEventListener('load', () => {
          loadedImages++;

          // Dispatch progress event
          const progressEvent = new CustomEvent('galleryProgress', {
            detail: {
              loaded: loadedImages,
              total: totalImages,
              progress: (loadedImages / totalImages) * 100
            }
          });
          gallery.dispatchEvent(progressEvent);

          // All images loaded
          if (loadedImages === totalImages) {
            const loadTime = performance.now() - loadStartTime;
            const completeEvent = new CustomEvent('galleryComplete', {
              detail: {
                totalImages,
                loadTime: Math.round(loadTime)
              }
            });
            gallery.dispatchEvent(completeEvent);
          }
        });

        img.addEventListener('error', () => {
          loadedImages++; // Count errors as "loaded" for progress
        });
      });
    }

    // Keyboard navigation for gallery
    gallery.addEventListener('keydown', (e) => {
      if (e.target?.closest('.gallery-item')) {
        const items = Array.from(gallery.querySelectorAll('.gallery-item'));
        const currentIndex = items.indexOf(e.target.closest('.gallery-item'));

        switch (e.key) {
          case 'ArrowRight':
          case 'ArrowDown':
            e.preventDefault();
            const nextItem = items[currentIndex + 1];
            if (nextItem) {
              const focusable = nextItem.querySelector('img, a, button, [tabindex="0"]');
              focusable?.focus();
            }
            break;

          case 'ArrowLeft':
          case 'ArrowUp':
            e.preventDefault();
            const prevItem = items[currentIndex - 1];
            if (prevItem) {
              const focusable = prevItem.querySelector('img, a, button, [tabindex="0"]');
              focusable?.focus();
            }
            break;

          case 'Home':
            e.preventDefault();
            const firstItem = items[0];
            if (firstItem) {
              const focusable = firstItem.querySelector('img, a, button, [tabindex="0"]');
              focusable?.focus();
            }
            break;

          case 'End':
            e.preventDefault();
            const lastItem = items[items.length - 1];
            if (lastItem) {
              const focusable = lastItem.querySelector('img, a, button, [tabindex="0"]');
              focusable?.focus();
            }
            break;
        }
      }
    });

    // Intersection observer for analytics
    if ('IntersectionObserver' in window) {
      const viewObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            const imageCard = entry.target;
            const imageId = imageCard.getAttribute('data-image-id');

            // Dispatch view event for analytics
            const viewEvent = new CustomEvent('imageViewed', {
              detail: {
                imageId,
                viewTime: Date.now(),
                position: Array.from(imageCard.parentNode.children).indexOf(imageCard)
              }
            });
            document.dispatchEvent(viewEvent);

            // Unobserve after first view
            viewObserver.unobserve(imageCard);
          }
        });
      }, {
        threshold: 0.5,
        rootMargin: '0px 0px -50px 0px'
      });

      // Observe all image cards
      gallery.querySelectorAll('.gallery-item').forEach((item) => {
        viewObserver.observe(item);
      });
    }
  });
</script>