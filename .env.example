# Local Development Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string for local development
# Use 'localhost' when running the backend outside Docker
# Use 'postgres' when running the backend inside Docker
DATABASE_URL=postgres://postgres:postgres@localhost:5432/randompic?sslmode=disable

# Alternative format for individual components
DB_HOST=localhost
DB_PORT=5432
DB_NAME=randompic
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage type: only 'local' for simplified architecture
STORAGE_TYPE=local

# Local filesystem storage path (relative to backend directory)
LOCAL_STORAGE_PATH=./storage/images

# Storage limits
MAX_UPLOAD_SIZE=2097152  # 2MB in bytes
MAX_TOTAL_STORAGE=10737418240  # 10GB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Storage directory structure
# Will create: ./storage/images/{user_id}/{year}/{month}/{filename}
STORAGE_ORGANIZE_BY_USER=true
STORAGE_ORGANIZE_BY_DATE=true

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port
PORT=8080

# Gin mode: debug, test, release
GIN_MODE=debug

# Request timeouts (in seconds)
READ_TIMEOUT=10
WRITE_TIMEOUT=30
IDLE_TIMEOUT=60

# Maximum request body size (in bytes) - 10MB
MAX_BODY_SIZE=10485760

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT configuration
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-security
JWT_EXPIRES_HOURS=24
JWT_ISSUER=randompic-api
JWT_AUDIENCE=randompic-users

# OAuth 2.0 Google configuration
OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Session configuration
SESSION_SECRET=your-session-secret-key-32-characters-minimum
SESSION_MAX_AGE=86400  # 24 hours in seconds

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000,http://127.0.0.1:4321
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_ENABLED=true

# Anonymous users (requests per window)
RATE_LIMIT_ANONYMOUS_REQUESTS=60
RATE_LIMIT_ANONYMOUS_WINDOW=900  # 15 minutes

# Authenticated users (requests per window)
RATE_LIMIT_AUTHENTICATED_REQUESTS=300
RATE_LIMIT_AUTHENTICATED_WINDOW=900  # 15 minutes

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Enable request logging
REQUEST_LOGGING=true

# Slow query threshold (in milliseconds)
SLOW_THRESHOLD=500

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Enable metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# DEVELOPMENT UTILITIES
# =============================================================================

# Enable development features
DEV_MODE=true

# Seed database with sample data
SEED_DATABASE=true

# Auto-migrate database on startup
AUTO_MIGRATE=true

# Pretty print JSON responses
PRETTY_JSON=true

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend URL for redirects
FRONTEND_URL=http://localhost:4321

# API URLs for frontend
PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080